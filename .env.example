# ---------------------------------------------------------------------------
# Leadership 1:1 Portal — environment
# Copy to .env.local for development. Set the same keys in Vercel for prod.
#
# There are NO Google credentials here. Scheduling is handled by monday.com's
# own Google Calendar integration, configured in the monday UI on the
# Leadership 1:1 Sessions board. The app never calls the Google API.
# ---------------------------------------------------------------------------

# Public base URL of the deployment. Used for the OAuth redirect and the
# session form links embedded in calendar events. No trailing slash.
APP_BASE_URL=http://localhost:3000

# --- monday OAuth -----------------------------------------------------------
# Create an app at https://<account>.monday.com → Developers → Build App → OAuth
# Redirect URI must be exactly: <APP_BASE_URL>/api/auth/callback
# Required scopes: me:read boards:read boards:write
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=

# --- Session ----------------------------------------------------------------
# 32+ random bytes. Generate: openssl rand -base64 32
SESSION_SECRET=

# --- Access control ---------------------------------------------------------
# Comma-separated monday user IDs allowed to see every enrollment, not just
# their own direct reports. Justin Nichols = 85159976
ADMIN_MONDAY_USER_IDS=
